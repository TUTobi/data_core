# Copy to .env for local development. All settings: src/data_core/config.py
DATABASE_URL=sqlite:///./data_core.db
CREATE_TABLES_ON_STARTUP=true
# DB_NULL_POOL=true   # no SQLAlchemy pooling; automatic on Vercel

# API keys per client role (comma-separated). Use long random values outside of local dev.
PI_KEYS=dev-pi-key
INPUT_KEYS=dev-input-key
DASHBOARD_KEYS=dev-dashboard-key
INTERNAL_KEYS=dev-internal-key
# AUTH_DISABLED=true

# Browser origins allowed to call the API (the dashboard), comma-separated
CORS_ORIGINS=http://localhost:5173
# Optional regex for extra origins, e.g. all Vercel preview URLs of the dashboard:
# CORS_ORIGIN_REGEX=https://hackathon-dashboard-[a-z0-9-]+-hackathon-x1\.vercel\.app

# What is mocked vs. real is NOT set here but in config.yaml (single source of truth).
# DATA_CORE_CONFIG=config.yaml

# Weather / geocoding tuning
WEATHER_CACHE_TTL_S=900
GEOCODING_COUNTRY_CODE=KE

# Core defaults (planner strategy: config.yaml)
DEFAULT_RADIUS_KM=10
DEFAULT_LOOKBACK_H=72
DEFAULT_FORECAST_H=48

# Recommender endpoint - required when config.yaml sets recommender.mocked: false
# A URL ending in /analyze is the potato engine (own format); anything else receives the DecisionContext.
RECOMMENDER_URL=https://recommendation-engine-2.vercel.app/analyze
# RECOMMENDER_URL=http://localhost:8001/predict   # mock recommender from mocks/
# RECOMMENDER_API_KEY=
# RECOMMENDER_TIMEOUT_S=40

# Delivery webhooks (dashboard + phone system). Empty = disabled.
# DASHBOARD_WEBHOOK_URL=http://localhost:8002/hooks/dashboard
# PHONE_WEBHOOK_URL=http://localhost:8002/hooks/phone
WEBHOOK_SECRET=dev-webhook-secret
