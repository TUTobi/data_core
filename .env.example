# Copy to .env for local development. All settings: src/data_core/config.py
DATABASE_URL=sqlite:///./data_core.db
CREATE_TABLES_ON_STARTUP=true

# API keys per client role (comma-separated). Use long random values outside of local dev.
PI_KEYS=dev-pi-key
INPUT_KEYS=dev-input-key
DASHBOARD_KEYS=dev-dashboard-key
INTERNAL_KEYS=dev-internal-key
# AUTH_DISABLED=true

# Weather: open_meteo | mock
WEATHER_PROVIDER=open_meteo
WEATHER_CACHE_TTL_S=900
GEOCODING_ENABLED=true
GEOCODING_COUNTRY_CODE=KE

# Core / planner (decision logic still undecided - fetch_all is the baseline)
PLANNER_STRATEGY=fetch_all
DEFAULT_RADIUS_KM=10
DEFAULT_LOOKBACK_H=72
DEFAULT_FORECAST_H=48

# Recommender: mock (in-process) | http (external service)
RECOMMENDER_MODE=mock
# RECOMMENDER_URL=http://localhost:8001/predict
# RECOMMENDER_API_KEY=

# Delivery webhooks (dashboard + phone system). Empty = disabled.
# DASHBOARD_WEBHOOK_URL=http://localhost:8002/hooks/dashboard
# PHONE_WEBHOOK_URL=http://localhost:8002/hooks/phone
WEBHOOK_SECRET=dev-webhook-secret
